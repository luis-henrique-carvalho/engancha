{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@engancha/contracts": ["packages/contracts/src/index.ts"],
      "@engancha/contracts/*": ["packages/contracts/src/*"]
    }
  },
  "exclude": ["node_modules", "dist", ".output", "coverage"]
}
