generator client {
  provider = "prisma-client"
  output   = "../apps/api/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String       @unique
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  role          String?
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[] @relation("Inviter")
  automations   Automation[] @relation("AutomationCreator")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String   @unique
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  activeOrganizationId String?
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
}

model Organization {
  id          String                @id
  name        String
  slug        String                @unique
  logo        String?
  metadata    String?
  createdAt   DateTime              @default(now())
  members     Member[]
  invitations Invitation[]
  automations Automation[]
  contents    Content[]
  executions  AutomationExecution[]
}

enum AutomationStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum AutomationRevisionStatus {
  DRAFT
  PUBLISHED
}

enum AutomationTriggerType {
  COMMENT_KEYWORD
}

enum AutomationActionType {
  PUBLIC_REPLY
  PRIVATE_REPLY
  LINK
  CAPTURE_EMAIL
  APPLY_TAG
}

enum ContentProvider {
  INSTAGRAM
  TIKTOK
}

enum ContentMode {
  SIMULATED
  REAL
}

enum ContentType {
  POST
  VIDEO
}

enum AutomationExecutionStatus {
  PENDING
  PROCESSING
  COMPLETED
  IGNORED
  FAILED
}

enum AutomationExecutionOutputType {
  PUBLIC_REPLY
  PRIVATE_REPLY
  LINK_DELIVERY
  EMAIL_CAPTURE_REQUEST
}

model Content {
  id                String                @id @default(uuid())
  organizationId    String
  provider          ContentProvider       @default(INSTAGRAM)
  mode              ContentMode           @default(SIMULATED)
  contentType       ContentType           @default(POST)
  title             String
  externalContentId String
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  targets           AutomationTarget[]
  executions        AutomationExecution[]

  @@unique([organizationId, provider, mode, contentType, externalContentId])
  @@index([organizationId, updatedAt])
}

model Automation {
  id                         String                @id @default(uuid())
  organizationId             String
  createdByUserId            String
  status                     AutomationStatus      @default(DRAFT)
  currentPublishedRevisionId String?               @unique
  activeContentId            String?
  activeKeywordNormalized    String?
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  publishedAt                DateTime?
  pausedAt                   DateTime?
  organization               Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy                  User                  @relation("AutomationCreator", fields: [createdByUserId], references: [id])
  revisions                  AutomationRevision[]
  currentPublishedRevision   AutomationRevision?   @relation("CurrentPublishedRevision", fields: [currentPublishedRevisionId], references: [id])
  originatingExecutions      AutomationExecution[] @relation("ExecutionOriginAutomation")
  matchedExecutions          AutomationExecution[] @relation("ExecutionAutomation")

  @@index([organizationId, status, updatedAt])
}

model AutomationRevision {
  id           String                   @id @default(uuid())
  automationId String
  version      Int
  status       AutomationRevisionStatus @default(DRAFT)
  name         String?
  createdAt    DateTime                 @default(now())
  publishedAt  DateTime?
  automation   Automation               @relation(fields: [automationId], references: [id], onDelete: Cascade)
  publishedFor Automation?              @relation("CurrentPublishedRevision")
  target       AutomationTarget?
  trigger      AutomationTrigger?
  actions      AutomationAction[]
  executions   AutomationExecution[]

  @@unique([automationId, version])
}

model AutomationTarget {
  id         String             @id @default(uuid())
  revisionId String             @unique
  contentId  String
  revision   AutomationRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)
  content    Content            @relation(fields: [contentId], references: [id])
}

model AutomationTrigger {
  id                String                @id @default(uuid())
  revisionId        String                @unique
  type              AutomationTriggerType @default(COMMENT_KEYWORD)
  keyword           String
  keywordNormalized String
  revision          AutomationRevision    @relation(fields: [revisionId], references: [id], onDelete: Cascade)
}

model AutomationAction {
  id         String               @id @default(uuid())
  revisionId String
  position   Int
  type       AutomationActionType
  config     Json
  revision   AutomationRevision   @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
}

model AutomationExecution {
  id                   String                      @id @default(uuid())
  organizationId       String
  contentId            String
  provider             ContentProvider
  mode                 ContentMode                 @default(SIMULATED)
  channelConnectionId  String?
  commentId            String?
  idempotencyKey       String
  inputAuthor          String
  inputText            String
  originAutomationId   String?
  automationId         String?
  automationRevisionId String?
  automationSnapshot   Json?
  status               AutomationExecutionStatus   @default(PENDING)
  matched              Boolean?
  attempts             Int                         @default(0)
  errorCode            String?
  errorMessage         String?
  stateVersion         Int                         @default(1)
  enqueuedAt           DateTime?
  startedAt            DateTime?
  completedAt          DateTime?
  createdAt            DateTime                    @default(now())
  updatedAt            DateTime                    @updatedAt
  organization         Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  content              Content                     @relation(fields: [contentId], references: [id])
  originAutomation     Automation?                 @relation("ExecutionOriginAutomation", fields: [originAutomationId], references: [id])
  automation           Automation?                 @relation("ExecutionAutomation", fields: [automationId], references: [id])
  automationRevision   AutomationRevision?         @relation(fields: [automationRevisionId], references: [id])
  outputs              AutomationExecutionOutput[]

  @@unique([organizationId, provider, mode, idempotencyKey])
  @@index([organizationId, status, createdAt])
  @@index([contentId, createdAt])
}

model AutomationExecutionOutput {
  id          String                        @id @default(uuid())
  executionId String
  key         String
  position    Int
  type        AutomationExecutionOutputType
  payload     Json
  createdAt   DateTime                      @default(now())
  execution   AutomationExecution           @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@unique([executionId, key])
  @@index([executionId, position])
}

model Member {
  id             String       @id
  organizationId String
  userId         String
  role           String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

model Invitation {
  id             String       @id
  organizationId String
  email          String
  role           String?
  status         String
  expiresAt      DateTime
  inviterId      String
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inviter        User         @relation("Inviter", fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
}
