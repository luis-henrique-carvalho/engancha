{
  "name": "@engancha/monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Fundação executável local do Engancha",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently --names web,api,worker --kill-others-on-fail \"npm run web:dev\" \"npm run api:dev\" \"npm run worker:dev\"",
    "web:dev": "npm run dev --workspace=@engancha/web",
    "web:build": "npm run build --workspace=@engancha/web",
    "web:preview": "npm run preview --workspace=@engancha/web",
    "api:dev": "npm run dev --workspace=@engancha/api",
    "api:start": "npm run start --workspace=@engancha/api",
    "worker:dev": "npm run dev --workspace=@engancha/worker",
    "worker:start": "npm run start --workspace=@engancha/worker",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "infra:up": "docker compose up -d postgres redis",
    "infra:down": "docker compose down",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --import tsx --test --test-concurrency=1 --test-force-exit tests/*.test.mjs",
    "test:e2e": "RUN_E2E=1 node --import tsx --test --test-concurrency=1 --test-force-exit tests/phase2-e2e.test.mjs",
    "verify": "npm run typecheck && npm test && npm run lint && npm run format:check"
  },
  "devDependencies": {
    "@eslint/js": "^9.33.0",
    "@nestjs/cli": "^11.0.10",
    "@types/node": "^24.3.0",
    "concurrently": "^9.2.4",
    "eslint": "^9.33.0",
    "globals": "^16.3.0",
    "prettier": "3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.39.0"
  }
}
